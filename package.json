{
  "name": "watchparty",
  "version": "1.0.0",
  "private": true,
  "description": "A synchronized watch party with direct playback, compatibility streaming, Movi Player and chat.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "build": "vite build",
    "test:ui": "vitest run",
    "test:all": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.0"
  },
  "trustedDependencies": [
    "@derhuerst/ffprobe-static",
    "ffmpeg-static"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
