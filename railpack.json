{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "steps": {
    "install": {
      "commands": [
        "COPY:package.json package.json",
        "COPY:package-lock.json package-lock.json",
        "npm install --global corepack@0.36.0 && corepack enable npm && corepack prepare npm@11.20.0 --activate",
        "npm ci --include=dev"
      ]
    },
    "build": {
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}
